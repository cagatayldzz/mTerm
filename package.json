{
  "name": "mterm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/app.sh --dev",
    "build": "bash scripts/app.sh release --build",
    "update": "cargo update",
    "release": "bun scripts/release.ts",
    "typecheck": "tsc --noEmit",
    "check": "bash scripts/app.sh --check",
    "test": "cargo test --locked --workspace",
    "commit": "git add -A && oco --yes"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
